#!/bin/sh
# main/master/dev 직접 커밋 차단 — 작업(feature) 브랜치에서 커밋하세요.
# (이 파일은 저장소에 커밋되어 공유된다. `.git/hooks/`는 클론 시 사라지므로,
#  새 클론에서는 `sh .harness/hooks/install.sh` 로 이 훅을 설치한다.)
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ] || [ "$branch" = "master" ] || [ "$branch" = "dev" ]; then
	echo "" >&2
	echo "❌ '$branch' 브랜치에 직접 커밋할 수 없습니다 (main·dev는 PR merge로만 갱신)." >&2
	echo "   작업 브랜치를 만들어 커밋하세요:  git switch -c feature/<이슈번호>-<기능>" >&2
	echo "   (부득이 우회: git commit --no-verify)" >&2
	exit 1
fi
