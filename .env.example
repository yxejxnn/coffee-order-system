# docker compose용 변수. 복사해서 .env로 사용 (.env는 gitignore됨)
# 주의: .env는 docker compose만 읽는다. Spring 앱(Gradle/IDE 실행)은 이 파일을 읽지 않으므로
# DB_USERNAME/DB_PASSWORD는 여기 넣어도 적용되지 않는다 — IDE Run Configuration의
# Environment variables 또는 셸에서 직접 export해서 넘길 것.
MYSQL_ROOT_PASSWORD=changeme_local_only
MYSQL_DATABASE=coffee_order
# 호스트에 이미 MySQL(3306)이 떠 있는 경우가 있어 컨테이너는 3307로 노출 (내부는 그대로 3306)
DB_PORT=3307
